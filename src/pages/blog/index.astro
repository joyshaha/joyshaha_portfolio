---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeading from '../../components/PageHeading.astro';
import PostCard from '../../components/PostCard.astro';
import Link from '../../components/Link.astro';
import Icon from '../../components/Icon.astro';
import { writing } from '../../data/writing';
import { site, diagramUrl, linkedinActivityUrl } from '../../data/site';
import { ui } from '../../data/ui';
const resources = [
  { title: 'LinkedIn', label: 'Thoughts & conversations', text: 'Follow my public activity and engineering posts.', href: linkedinActivityUrl },
  { title: 'GitHub', label: 'Code & experiments', text: 'Explore the implementation behind my technical projects.', href: site.socials[0].url },
  { title: 'tldraw', label: 'Architecture workspace', text: 'Open my shared workspace for visual thinking and diagrams.', href: diagramUrl },
];
---
<BaseLayout title="Blog · Engineering notes">
  <PageHeading eyebrow="Blog & engineering notes" title="Ideas, code, and the connections between them." description="Notes on full-stack development, backend architecture, and DevOps, connected with my public work and learning spaces." />
  <section class="mb-14 grid gap-5 md:grid-cols-3" aria-label="Connected publishing and diagram resources">{resources.map(resource => <article class="rounded-xl border border-line bg-panel p-6"><p class="mb-3 font-mono text-xs uppercase tracking-wide text-muted">{resource.label}</p><h2 class="mb-3 text-2xl font-semibold">{resource.title}</h2><p class="mb-5 text-sm text-muted">{resource.text}</p><Link href={resource.href} class={ui.textLink}>Open {resource.title}<Icon name="external" size={17} /></Link></article>)}</section>
  <div class="mb-7"><h2 class="mb-3 text-3xl font-semibold">Engineering notes</h2><p class="text-sm text-muted">Portfolio notes connected to project repositories. LinkedIn posts and the shared diagram workspace remain on their original platforms.</p></div>
  <section class="grid gap-6 lg:grid-cols-3" aria-label="Engineering articles">{writing.map(post => <PostCard title={post.title} description={post.summary} category={post.category} readTime={post.readTime} url={`/blog/${post.slug}/`} />)}</section>
</BaseLayout>

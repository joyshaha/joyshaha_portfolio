---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeading from '../components/PageHeading.astro';
import Link from '../components/Link.astro';
import { ui } from '../data/ui';
---
<BaseLayout title="Page not found" noindex>
  <PageHeading eyebrow="404 / Page not found" title="A little off the path." description="This page doesn’t exist. Let’s get you back to the portfolio." />
  <Link href="/" class={ui.button}>Back to home</Link>
</BaseLayout>

---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { ui } from '../data/ui';
interface Props { title: string; description?: string; fullWidth?: boolean; noindex?: boolean; }
const { title, description = site.bio, fullWidth = false, noindex = false } = Astro.props;
const pageTitle = `${title} | ${site.name}`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const profile = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  ...(canonical ? { url: canonical.href } : {}),
  mainEntity: {
    '@type': 'Person',
    name: site.name,
    jobTitle: site.role,
    description: site.bio,
    email: `mailto:${site.email}`,
    homeLocation: { '@type': 'Place', name: site.location },
    sameAs: site.socials.map(social => social.url),
    knowsAbout: ['Full-stack engineering', 'Backend development', 'DevOps', 'Python', 'React', 'AWS', 'GCP', 'Terraform', 'HCL'],
  },
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8f9fb" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {canonical && <meta property="og:url" content={canonical.href} />}
    {Astro.url.pathname === '/' && <script type="application/ld+json" set:html={JSON.stringify(profile).replace(/</g, '\\u003c')} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a href="#main-content" class="fixed -top-32 left-5 z-50 rounded border border-brand bg-white px-5 py-3 focus:top-4">Skip to content</a>
    <Header />
    <main id="main-content" class:list={[!fullWidth && [ui.container, 'min-h-[65vh] py-14 sm:py-20']]} tabindex="-1"><slot /></main>
    <Footer name={site.name} />
  </body>
</html>

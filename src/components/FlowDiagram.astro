---
import Icon from './Icon.astro';
interface Props { steps: string[]; tone?: 'health' | 'finance' | 'system'; title?: string; }
const { steps, tone = 'system', title = 'Workflow overview' } = Astro.props;
const tones = { health: 'bg-emerald-50 text-emerald-900', finance: 'bg-indigo-50 text-indigo-900', system: 'bg-slate-100 text-slate-800' };
---
<div class:list={['rounded-xl p-6 sm:p-9', tones[tone]]}>
  <p class="mb-6 font-mono text-xs uppercase tracking-wide">{title}</p>
  <ol class="mx-auto max-w-md">{steps.map((step, index) => <li>
    <div class="flex items-center gap-4 rounded-md border border-slate-300 bg-white px-4 py-4 text-sm"><span class="font-mono text-xs">0{index + 1}</span><span class="flex-1">{step}</span><Icon name="check" size={17} /></div>
    {index < steps.length - 1 && <div class="mx-auto h-5 w-px border-l border-dashed border-slate-400" aria-hidden="true"></div>}
  </li>)}</ol>
  <p class="mt-6 text-xs">Conceptual workflow · not a product screenshot</p>
</div>

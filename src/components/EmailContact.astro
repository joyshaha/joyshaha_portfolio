---
import { site } from '../data/site';
import { ui } from '../data/ui';
import Link from './Link.astro';
import Icon from './Icon.astro';
---
<div class="grid gap-7 lg:grid-cols-[1.2fr_1fr]">
  <div class="rounded-xl bg-night p-7 text-white sm:p-10">
    <p class="mb-4 font-mono text-xs uppercase tracking-widest text-blue-200">PROJECTS & OPPORTUNITIES</p>
    <h3 class="mb-5 text-3xl font-semibold">Let’s make the next step happen.</h3>
    <p class="mb-5 text-sm leading-relaxed text-slate-300">Tell me about your project, current system, or engineering role. Include your goals and timeline so we can start with useful context.</p>
    <Link href={site.contactUrl} class="inline-flex min-h-11 items-center gap-2 break-all text-base font-semibold hover:text-blue-200 sm:text-xl">{site.email}<Icon name="mail" size={20} /></Link>
    <p class="mt-4 text-xs text-slate-300">Dhaka, Bangladesh · UTC+6</p>
    <div class="mt-7 flex gap-6">{site.socials.map(social => <Link href={social.url} class="inline-flex min-h-11 items-center gap-2 text-sm hover:text-blue-200">{social.label}<Icon name="external" size={17} /></Link>)}</div>
  </div>
  <div class="rounded-xl border border-line bg-white p-7 sm:p-10">
    <h3 class="mb-4 text-2xl font-semibold">Choose how to get in touch.</h3>
    <Link href={site.contactUrl} class:list={[ui.button, 'mb-3 w-full']}>Write an email<Icon name="mail" size={18} /></Link>
    <p class="mb-6 text-xs text-muted">Opens your default email app with a draft ready to edit.</p>
    <Link href={site.gmailUrl} class:list={[ui.secondary, 'mb-3 w-full']}>Compose in Gmail<Icon name="external" size={18} /></Link>
    <p class="mb-6 text-xs text-muted">Prefer browser email? Use Gmail, or copy the address below.</p>
    <div data-email-copy class="hidden" data-email={site.email}>
      <button type="button" class="inline-flex min-h-11 cursor-pointer items-center gap-2 rounded-md border border-line px-4 py-2 text-sm font-semibold hover:border-brand hover:text-brand" data-copy-button>Copy email address</button>
      <p class="mt-3 text-xs text-muted" data-copy-status aria-live="polite"></p>
    </div>
  </div>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-email-copy]').forEach(container => {
    container.classList.remove('hidden');
    const button = container.querySelector<HTMLButtonElement>('[data-copy-button]');
    const status = container.querySelector<HTMLElement>('[data-copy-status]');
    button?.addEventListener('click', async () => {
      if (!status) return;
      try {
        await navigator.clipboard.writeText(container.dataset.email ?? '');
        status.textContent = 'Email address copied. Paste it into your email service.';
      } catch {
        status.textContent = `Select and copy this address: ${container.dataset.email}`;
      }
    });
  });
</script>

---
interface Props { name?: string; size?: number; }
const { name = 'arrow', size = 20 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'download' && <path d="M12 3v12m-5-5 5 5 5-5M4 16v5h16v-5" />}
  {name === 'arrow' && <path d="M5 12h14m-6-6 6 6-6 6" />}
  {name === 'external' && <path d="M7 17 17 7M7 7h10v10" />}
  {name === 'window' && <><rect x="3" y="4" width="18" height="16" rx="2" /><path d="M3 9h18M7 6.5h.01M10 6.5h.01m-1 6-3 2 3 2m6-4 3 2-3 2" /></>}
  {name === 'layers' && <path d="m12 3 10 5-10 5L2 8l10-5Zm-9 9 9 5 9-5M3 16l9 5 9-5" />}
  {name === 'cloud' && <path d="M7 18a5 5 0 0 1-.9-9.9 6 6 0 0 1 11.5 1A4.5 4.5 0 0 1 18 18M12 21V12m-3 3 3-3 3 3" />}
  {name === 'check' && <path d="m5 12 4 4L19 6" />}
  {name === 'mail' && <><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 6 9 7 9-7" /></>}
</svg>
